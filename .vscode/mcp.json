{
  "servers": {
    "fastast": {
      "type": "stdio",
      "command": "python3",
      "args": ["-m", "fastast.mcp"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/python"
      }
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${input:stitch_api_key}"
      }
    }
  },
  "inputs": [
    {
      "id": "stitch_api_key",
      "type": "promptString",
      "description": "Google Stitch API Key",
      "password": true
    }
  ]
}
